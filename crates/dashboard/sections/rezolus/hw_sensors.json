{
  "name": "Hardware Sensors",
  "route": "/hw_sensors",
  "groups": [
    {
      "name": "Hardware Sensors",
      "id": "hw_sensors",
      "subgroups": [
        {
          "when": {
            "all": [
              {
                "present": "sensor_temperature"
              },
              {
                "has_label": {
                  "metric": "sensor_temperature",
                  "label": "name"
                }
              }
            ]
          },
          "then": [
            {
              "name": "Temperature",
              "description": "Temperatures, one series per channel. Missing or unreadable sensors are absent.",
              "plots": [
                {
                  "kind": "gauge",
                  "title": "Temperature",
                  "id": "sensor-temperature",
                  "unit": "count",
                  "axis_label": "°C",
                  "query": "sum by (name) (sensor_temperature) / 1000",
                  "width": "full"
                }
              ]
            }
          ]
        },
        {
          "when": {
            "all": [
              {
                "present": "sensor_temperature"
              },
              {
                "not": {
                  "has_label": {
                    "metric": "sensor_temperature",
                    "label": "name"
                  }
                }
              }
            ]
          },
          "then": [
            {
              "name": "Temperature",
              "description": "Temperatures, one series per channel. Missing or unreadable sensors are absent.",
              "plots": [
                {
                  "kind": "gauge",
                  "title": "Temperature",
                  "id": "sensor-temperature",
                  "unit": "count",
                  "axis_label": "°C",
                  "query": "sum by (sensor) (sensor_temperature) / 1000",
                  "width": "full"
                }
              ]
            }
          ]
        },
        {
          "when": {
            "all": [
              {
                "present": "sensor_power"
              },
              {
                "has_label": {
                  "metric": "sensor_power",
                  "label": "name"
                }
              }
            ]
          },
          "then": [
            {
              "name": "Power",
              "description": "Power per native channel, including direct readings and marked derived readings. Derived power can pair sequential voltage and current reads; channels are not summed across rails because rails can overlap.",
              "plots": [
                {
                  "kind": "gauge",
                  "title": "Power",
                  "id": "sensor-power",
                  "unit": "power",
                  "axis_label": "Watts",
                  "query": "sum by (name) (sensor_power) / 1000000",
                  "width": "full"
                }
              ]
            }
          ]
        },
        {
          "when": {
            "all": [
              {
                "present": "sensor_power"
              },
              {
