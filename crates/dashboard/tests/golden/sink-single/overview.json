  "groups": [
    {
      "name": "CPU",
      "id": "cpu",
      "subgroups": [
        {
          "name": "CPU Busy",
          "description": "Overall CPU utilization and per-core breakdown.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "Busy %",
                "id": "cpu-busy",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "percentage",
                  "precision": 2,
                  "log_scale": null,
                  "range": {
                    "min": 0.0,
                    "max": 1.0
                  },
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(cpu_usage[5m])) / cpu_cores / 1000000000"
            },
            {
              "data": [],
              "opts": {
                "title": "Busy %",
                "id": "cpu-busy-heatmap",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "percentage",
                  "precision": 2,
