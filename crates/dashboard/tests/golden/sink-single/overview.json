                  "unit_system": "bitrate",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(network_bytes{direction=\"transmit\"}[5m])) * 8"
            },
            {
              "data": [],
              "opts": {
                "title": "Receive Bandwidth",
