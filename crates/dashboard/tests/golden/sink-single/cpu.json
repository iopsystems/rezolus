    {
      "name": "Performance",
      "id": "performance",
      "subgroups": [
        {
          "name": "Instructions per Cycle",
          "description": "How efficiently the CPU retires instructions per clock cycle.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "IPC",
                "id": "ipc",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "count",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(cpu_instructions[5m])) / sum(irate(cpu_cycles[5m]))",
              "width": "full"
            }
          ]
        },
        {
          "name": "Instructions per Nanosecond",
          "description": "Wall-clock-normalized instruction throughput — accounts for frequency scaling.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "IPNS",
                "id": "ipns",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "count",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(cpu_instructions[5m])) / sum(irate(cpu_cycles[5m])) * sum(irate(cpu_tsc[5m])) * sum(irate(cpu_aperf[5m])) / sum(irate(cpu_mperf[5m])) / 1000000000 / cpu_cores",
              "width": "full"
            }
          ]
        },
        {
          "name": "L3 Cache Hit Rate",
          "description": "Fraction of L3 cache accesses that hit, indicating last-level cache efficiency.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "L3 Hit %",
                "id": "l3-hit",
                "type": "delta_counter",
                "format": {
