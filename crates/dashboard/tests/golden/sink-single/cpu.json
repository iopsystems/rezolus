                  "y_axis_label": null,
                  "unit_system": "percentage",
                  "precision": 2,
                  "log_scale": null,
                  "range": {
                    "min": 0.0,
                    "max": 1.0
                  },
                  "value_label": null
                }
              },
              "promql_query": "1 - sum(irate(cpu_l3_miss[5m])) / sum(irate(cpu_l3_access[5m]))",
              "width": "full"
            }
          ]
        },
        {
          "name": "Frequency",
