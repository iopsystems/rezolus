        {
          "name": "Total CPU",
          "description": "Overall CPU busy time across all cores, with per-core breakdown.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "Busy %",
                "id": "busy-pct",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "percentage",
                  "precision": 2,
                  "log_scale": null,
                  "range": {
                    "min": 0.0,
                    "max": 1.0
                  },
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(cpu_usage[5m])) / cpu_cores / 1000000000",
              "width": "full"
            }
          ]
        },
