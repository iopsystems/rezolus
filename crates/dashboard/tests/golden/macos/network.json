      "subgroups": [
        {
          "name": "Host Bandwidth",
          "description": "Bits per second crossing the host boundary, counted once at the interface bound to a device driver — the wire on bare metal, the hypervisor boundary in a VM guest. Matches the NIC's own counters. Excludes intra-host traffic between virtual interfaces (container east-west, loopback).",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "Host Bandwidth Transmit",
                "id": "host-bandwidth-tx",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "bitrate",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(network_host_bytes{direction=\"transmit\"}[5m])) * 8"
