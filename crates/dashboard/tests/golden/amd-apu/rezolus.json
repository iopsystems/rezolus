{
  "interval": 1.0,
  "source": "rezolus",
  "version": "6.0.0",
  "filename": "",
  "start_time": 1700000000000.0,
  "end_time": 1700000060000.0,
  "groups": [
    {
      "name": "Rezolus",
      "id": "rezolus",
      "subgroups": [
        {
          "name": "Resource Usage",
          "description": "CPU and memory consumed by the Rezolus agent itself.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "CPU %",
                "id": "cpu",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "percentage",
                  "precision": 2,
                  "log_scale": null,
                  "range": {
                    "min": 0.0,
                    "max": 1.0
                  },
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(rezolus_cpu_usage[5m])) / 1000000000"
            },
            {
              "data": [],
              "opts": {
                "title": "Memory (RSS)",
                "id": "memory",
                "type": "gauge",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "bytes",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(rezolus_memory_usage_resident_set_size)"
            }
          ]
        },
        {
          "name": "Performance",
          "description": "Rezolus's own IPC and syscall rate, measured via the rezolus.service cgroup.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "IPC",
                "id": "ipc",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "count",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(cgroup_cpu_instructions{name=\"/system.slice/rezolus.service\"}[5m])) / sum(irate(cgroup_cpu_cycles{name=\"/system.slice/rezolus.service\"}[5m]))"
            },
            {
              "data": [],
              "opts": {
                "title": "Syscalls",
                "id": "syscalls",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "rate",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(cgroup_syscall{name=\"/system.slice/rezolus.service\"}[5m]))"
            }
          ]
        },
        {
          "name": "BPF Overhead",
          "description": "Time spent in BPF programs — total agent overhead and per-sampler breakdown.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "Total BPF Overhead",
                "id": "bpf-overhead",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "count",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(rezolus_bpf_run_time[5m])) / 1000000000",
              "width": "full"
            },
            {
              "data": [],
              "opts": {
                "title": "BPF Per-Sampler Overhead",
                "id": "bpf-sampler-overhead",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "count",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum by (sampler) (irate(rezolus_bpf_run_time[5m])) / 1000000000"
            },
            {
              "data": [],
              "opts": {
                "title": "BPF Per-Sampler Execution Time",
                "id": "bpf-execution-time",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "time",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "(sum by (sampler) (irate(rezolus_bpf_run_time[5m])) / sum by (sampler) (irate(rezolus_bpf_run_count[5m]))) / 1000000000"
            }
          ]
        }
      ]
    }
  ],
