    {
      "name": "Traffic",
      "id": "traffic",
      "subgroups": [
        {
          "name": "Interface Bandwidth",
          "description": "Bits per second summed over every network interface the traffic traverses. A packet crossing a stacked interface (bond, VLAN, bridge, tunnel) is counted once per layer, so this reads higher than the host bandwidth above — roughly 2x on a bonded host, 3x for VLAN-over-bond. It also includes loopback and intra-host virtual traffic that never reaches a NIC, which on a container or VM host can dominate.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "Bandwidth Transmit",
                "id": "bandwidth-tx",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "bitrate",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(network_bytes{direction=\"transmit\"}[5m])) * 8"
            },
            {
              "data": [],
              "opts": {
                "title": "Bandwidth Receive",
                "id": "bandwidth-rx",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "bitrate",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(network_bytes{direction=\"receive\"}[5m])) * 8"
            }
          ]
