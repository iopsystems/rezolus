  "interval": 1.0,
  "source": "rezolus",
  "version": "6.0.0",
  "filename": "",
  "start_time": 1700000000000.0,
  "end_time": 1700000060000.0,
  "groups": [
    {
      "name": "CPU",
      "id": "cpu",
      "subgroups": [
        {
          "name": "CPU Busy",
          "description": "Overall CPU utilization and per-core breakdown.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "Busy %",
                "id": "cpu-busy",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "percentage",
                  "precision": 2,
                  "log_scale": null,
                  "range": {
                    "min": 0.0,
                    "max": 1.0
                  },
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(cpu_usage[5m])) / cpu_cores / 1000000000"
            },
            {
              "data": [],
              "opts": {
                "title": "Busy %",
                "id": "cpu-busy-heatmap",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "percentage",
                  "precision": 2,
                  "log_scale": null,
                  "range": {
                    "min": 0.0,
                    "max": 1.0
                  },
                  "value_label": null
                }
              },
              "promql_query": "sum by (id) (irate(cpu_usage[5m])) / 1000000000"
            }
          ]
        }
      ]
    },
    {
      "name": "Normalized by Throughput",
      "id": "normalized-throughput",
      "subgroups": [
        {
          "name": "Efficiency Metrics",
          "description": "Resource consumption normalized by service throughput — lower is more efficient.",
          "plots": [
            {
              "data": [],
              "opts": {
                "title": "CPU Time / Throughput",
                "id": "normalized-cpu-busy",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "time",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "sum(irate(cpu_usage[5m])) / (sum(irate(requests[5m])))"
            },
            {
              "data": [],
              "opts": {
                "title": "Network TX / Throughput",
                "id": "normalized-network-tx",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "count",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "(sum(irate(network_bytes{direction=\"transmit\"}[5m])) * 8) / (sum(irate(requests[5m])))"
            },
            {
              "data": [],
              "opts": {
                "title": "Network RX / Throughput",
                "id": "normalized-network-rx",
                "type": "delta_counter",
                "format": {
                  "x_axis_label": null,
                  "y_axis_label": null,
                  "unit_system": "count",
                  "precision": 2,
                  "log_scale": null,
                  "value_label": null
                }
              },
              "promql_query": "(sum(irate(network_bytes{direction=\"receive\"}[5m])) * 8) / (sum(irate(requests[5m])))"
            }
          ]
        }
      ]
    }
  ],
