#!/bin/bash
set -e

PROGRAM="$(basename "$0")"

# Defaults
DURATION=""
COMMAND=()
MONITOR_PID=""
ENDPOINTS=()
SOURCES=()
INTERVAL="1s"
REZOLUS="${REZOLUS:-rezolus}"
AGENT="http://127.0.0.1:4241"
OUTPUT_DIR="/data"
VIEWER_LISTEN="0.0.0.0:8080"
NO_VIEWER=false
RECORDER_PID=""
STAGING=""
INTERRUPTED=false

help() {
    cat <<EOF
$PROGRAM - Capture system and service metrics, then view the results.

The Rezolus agent must already be running (started by the container entrypoint).
This script records system metrics from the local agent and optionally service
metrics from Prometheus-compatible endpoints into one .dendro archive,
capture.dendro, holding a recording per endpoint (source=rezolus for the agent,
source=<NAME> for each service), and launches the Rezolus viewer on it.

USAGE:
    $PROGRAM <--duration <DURATION> | --command <CMD...> | --pid <PID>> [OPTIONS]

CAPTURE MODE (exactly one required):
    --duration <DURATION>       How long to capture (e.g., 60s, 5m, 1h)
    --command <CMD...>          Run CMD and capture while it runs. All remaining
                                arguments are treated as the command to execute.
    --pid <PID>                 Capture while an existing process is running.
                                Stops when the process exits.

OPTIONS:
    --endpoint <URL>            Service metrics endpoint (Prometheus-compatible).
                                Can be specified multiple times for multiple services.
    --source <NAME>             Source name for service metrics: the source label
                                of that endpoint's recording. Must be specified
                                once per --endpoint, in the same order.
    --interval <INTERVAL>       Sampling interval (default: 1s)
    --output-dir <DIR>          Directory capture.dendro is written to (default: /data);
                                an existing capture.dendro there is replaced
    --viewer-listen <ADDR>      Viewer listen address (default: 0.0.0.0:8080)
    --no-viewer                 Skip launching the viewer after capture
    --rezolus <PATH>            Path to the rezolus binary (default: rezolus)
    -h, --help                  Show this help text

EXAMPLES:
    # System metrics only for 60 seconds
    $PROGRAM --duration 60s

    # System + Redis metrics for 2 minutes
    $PROGRAM --duration 2m \\
        --endpoint http://localhost:9121/metrics \\
        --source redis

    # Multiple service endpoints
    $PROGRAM --duration 60s \\
        --endpoint http://localhost:9121/metrics --source redis \\
        --endpoint http://localhost:8080/metrics --source myapp

    # Record while running a benchmark
    $PROGRAM --command ./run-benchmark.sh --arg1 --arg2

    # Capture while a process is running
    $PROGRAM --pid 12345

    # Capture without launching the viewer
    $PROGRAM --duration 60s --no-viewer
EOF
}

error() {
    echo "Error: $1" >&2
    echo "Try '$PROGRAM --help' for more information." >&2
    exit 1
}

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            help
            exit 0
            ;;
        --duration)
            [ -n "${2:-}" ] || error "--duration requires a value"
            DURATION="$2"; shift 2
            ;;
        --command)
            shift
            if [ $# -eq 0 ]; then
                error "--command requires a command to run"
            fi
            # Consume all remaining arguments as the command
            COMMAND=("$@")
            shift $#
            ;;
        --pid)
            [ -n "${2:-}" ] || error "--pid requires a value"
            MONITOR_PID="$2"; shift 2
            ;;
        --endpoint)
            [ -n "${2:-}" ] || error "--endpoint requires a value"
            ENDPOINTS+=("$2"); shift 2
            ;;
        --source)
            [ -n "${2:-}" ] || error "--source requires a value"
            SOURCES+=("$2"); shift 2
            ;;
        --interval)
            [ -n "${2:-}" ] || error "--interval requires a value"
            INTERVAL="$2"; shift 2
            ;;
        --output-dir)
            [ -n "${2:-}" ] || error "--output-dir requires a value"
            OUTPUT_DIR="$2"; shift 2
            ;;
        --viewer-listen)
            [ -n "${2:-}" ] || error "--viewer-listen requires a value"
            VIEWER_LISTEN="$2"; shift 2
            ;;
        --no-viewer)
            NO_VIEWER=true; shift
            ;;
        --rezolus)
            [ -n "${2:-}" ] || error "--rezolus requires a value"
            REZOLUS="$2"; shift 2
            ;;
        *)
            error "unexpected argument '$1'"
            ;;
    esac
done

# Validate capture mode: exactly one of --duration, --command, --pid
MODE_COUNT=0
[ -n "$DURATION" ] && MODE_COUNT=$((MODE_COUNT + 1))
[ ${#COMMAND[@]} -gt 0 ] && MODE_COUNT=$((MODE_COUNT + 1))
[ -n "$MONITOR_PID" ] && MODE_COUNT=$((MODE_COUNT + 1))

if [ "$MODE_COUNT" -eq 0 ]; then
    error "one of --duration, --command, or --pid is required"
fi
if [ "$MODE_COUNT" -gt 1 ]; then
    error "--duration, --command, and --pid are mutually exclusive"
fi

# Validate endpoint/source pairing
if [ ${#ENDPOINTS[@]} -ne ${#SOURCES[@]} ]; then
    error "each --endpoint must have a corresponding --source (got ${#ENDPOINTS[@]} endpoints and ${#SOURCES[@]} sources)"
fi

# Validate source names: each names one recording in the archive, so they
# must be unique, and `rezolus` is the agent's. A `,` or `=` would split the
# `--endpoint url,source=NAME` value into other options. A nested loop rather
# than an associative array, which the bash 3.2 macOS ships does not have.
for i in "${!SOURCES[@]}"; do
    if [ "${SOURCES[$i]}" = "rezolus" ]; then
        error "source name 'rezolus' is reserved for the agent's recording"
    fi
    case "${SOURCES[$i]}" in
        *,*|*=*)
            error "source name must not contain ',' or '=': ${SOURCES[$i]}"
            ;;
    esac
    for j in "${!SOURCES[@]}"; do
        if [ "$j" -lt "$i" ] && [ "${SOURCES[$j]}" = "${SOURCES[$i]}" ]; then
            error "duplicate source name: ${SOURCES[$i]}"
        fi
    done
done

# Validate --pid target exists
if [ -n "$MONITOR_PID" ]; then
    if ! kill -0 "$MONITOR_PID" 2>/dev/null; then
        error "process $MONITOR_PID not found"
    fi
fi

# Verify the agent is running
if ! curl -sf "$AGENT/" > /dev/null 2>&1; then
    error "Rezolus agent is not running on 127.0.0.1:4241"
fi

# Detect the invoking user when running under sudo
REAL_USER="${SUDO_USER:-$(id -un)}"
REAL_GROUP="$(id -gn "$REAL_USER" 2>/dev/null || id -gn)"

# The archive is written into a staging directory beside the output, so a
# finished capture is moved into place with a rename and a failed one never
# replaces an earlier capture.dendro. `rezolus record` refuses an output path
# that already exists.
mkdir -p "$OUTPUT_DIR"
chown "$REAL_USER:$REAL_GROUP" "$OUTPUT_DIR" 2>/dev/null || true
OUTPUT_FILE="${OUTPUT_DIR%/}/capture.dendro"
STAGING="$(mktemp -d "${OUTPUT_DIR%/}/.capture-XXXXXX")"
STAGED_FILE="$STAGING/capture.dendro"

cleanup() {
    # Stop the recorder if it is still running: the script is exiting on an
    # error or a signal other than the SIGINT the --pid loop handles. The
    # recorder treats a second SIGINT or SIGTERM as "terminate immediately",
    # and the staging directory is removed below, so this capture is lost.
    if [ -n "$RECORDER_PID" ]; then
        kill "$RECORDER_PID" 2>/dev/null || true
        wait "$RECORDER_PID" 2>/dev/null || true
    fi

    if [ -n "$STAGING" ]; then
        rm -rf "$STAGING"
    fi
}
trap cleanup EXIT

# One recorder for every endpoint: the agent is recorded from its stream and
# each service endpoint is scraped, each into its own recording of one
# archive, told apart by its source label.
RECORD=("$REZOLUS" record --endpoint "${AGENT},source=rezolus")
for i in "${!ENDPOINTS[@]}"; do
    RECORD+=(--endpoint "${ENDPOINTS[$i]},source=${SOURCES[$i]}")
done
RECORD+=(-o "$STAGED_FILE" -i "$INTERVAL")

echo "Recording from $AGENT (source: rezolus)..."
for i in "${!ENDPOINTS[@]}"; do
    echo "Recording from ${ENDPOINTS[$i]} (source: ${SOURCES[$i]})..."
done

if [ -n "$DURATION" ]; then
    echo "Capturing for $DURATION (interval: $INTERVAL)..."
    if ! "${RECORD[@]}" -d "$DURATION"; then
        echo "Error: the recording failed" >&2
        exit 1
    fi

elif [ ${#COMMAND[@]} -gt 0 ]; then
    # The recorder runs the command and records for exactly its lifetime. It
    # exits with the command's status, or 1 if the recording itself failed.
    echo "Capturing while running: ${COMMAND[*]} (interval: $INTERVAL)"
    set +e
    "${RECORD[@]}" -- "${COMMAND[@]}"
    CMD_EXIT=$?
    set -e
    echo "Command exited with status $CMD_EXIT"

else
    echo "Capturing while process $MONITOR_PID is running (interval: $INTERVAL)..."
    # Ctrl-C at a terminal sends SIGINT to the whole process group, so the
    # recorder already has it and is finalizing the archive. Without this
    # trap the script would exit and the EXIT trap would send the recorder a
    # second signal, which aborts the archive, and then remove it.
    trap 'INTERRUPTED=true' INT
    "${RECORD[@]}" &
    RECORDER_PID=$!
    while ! $INTERRUPTED && kill -0 "$MONITOR_PID" 2>/dev/null; do
        if ! kill -0 "$RECORDER_PID" 2>/dev/null; then
            wait "$RECORDER_PID" || true
            RECORDER_PID=""
            echo "Error: the recorder exited before process $MONITOR_PID did" >&2
            exit 1
        fi
        # The same SIGINT kills `sleep`, which `set -e` would make fatal.
        sleep 1 || true
    done
    if $INTERRUPTED; then
        echo "Interrupted, waiting for the recorder to finalize the capture..."
    else
        echo "Process $MONITOR_PID exited, stopping capture..."
        kill "$RECORDER_PID" 2>/dev/null || true
    fi
    if ! wait "$RECORDER_PID"; then
        RECORDER_PID=""
        echo "Error: the recording failed" >&2
        exit 1
    fi
    RECORDER_PID=""
    trap - INT
fi

if [ ! -s "$STAGED_FILE" ]; then
    echo "Error: no recording was produced" >&2
    exit 1
fi

# Replace an earlier capture, including any SQLite sidecars a reader left.
# `mv -f` renames over the old file, so a reader never sees no capture.
rm -f "$OUTPUT_FILE-wal" "$OUTPUT_FILE-shm"
mv -f "$STAGED_FILE" "$OUTPUT_FILE"
# Removed here rather than by the EXIT trap, which `exec` below skips.
rm -rf "$STAGING"
STAGING=""
chown "$REAL_USER:$REAL_GROUP" "$OUTPUT_FILE" 2>/dev/null || true
chmod 644 "$OUTPUT_FILE" 2>/dev/null || true
echo "Recording complete: $OUTPUT_FILE"

# Show metadata summary
echo ""
echo "Recording metadata:"
"$REZOLUS" recording metadata -i "$OUTPUT_FILE" 2>/dev/null || true
echo ""

# Launch viewer
if ! $NO_VIEWER; then
    echo "Launching viewer at http://$VIEWER_LISTEN ..."
    exec "$REZOLUS" view "$OUTPUT_FILE" --listen "$VIEWER_LISTEN"
else
    echo "Done. View the recording with:"
    echo "  $REZOLUS view $OUTPUT_FILE"
fi
